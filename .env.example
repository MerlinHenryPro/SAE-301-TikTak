# Copier ce fichier en ".env" et remplir les valeurs (ne jamais committer .env)

# URL publique du site (sans / final). En local : http://localhost:4321
SITE_URL=https://tiktak.mondomaine.fr

# Serveur Node
HOST=127.0.0.1
PORT=4321

# Base SQLite (sur le VPS : /var/www/tiktak/data/tiktak.sqlite)
DATABASE_PATH=./data/tiktak.sqlite

# Authentification Google (console.cloud.google.com > API et services > Identifiants)
# URI de redirection autorisée : <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IA OpenRouter (openrouter.ai > Keys). Laisser vide = mode de secours par mots-clés
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
