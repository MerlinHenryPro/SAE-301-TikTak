---
import Layout from '../../layouts/Layout.astro';
import MontreCard from '../../components/MontreCard.astro';
import { montresUtilisateur } from '../../lib/montres.js';

const { user, t } = Astro.locals;
const montres = montresUtilisateur(user.id_utilisateur);
---
<Layout titre={t('montres.titre')} noindex>
  <div class="max-w-7xl mx-auto px-4 py-10">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div>
        <p class="eyebrow">Mon espace</p>
        <h1 class="text-5xl mt-2">{t('montres.titre')}</h1>
        <p class="text-base-content/60 mt-2">{montres.length} création{montres.length > 1 ? 's' : ''} enregistrée{montres.length > 1 ? 's' : ''}</p>
      </div>
      <a href="/configurateur" class="btn btn-primary">+ Nouvelle création</a>
    </div>

    {montres.length === 0 ? (
      <div class="text-center py-24 border border-dashed border-base-300 rounded-box">
        <p class="text-base-content/60">{t('montres.vide')}</p>
        <a href="/configurateur" class="btn btn-primary mt-4">Créer ma première montre</a>
      </div>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {montres.map((m) => <MontreCard {...m} />)}
      </div>
    )}
  </div>

  <dialog id="dlg-supprimer" class="modal">
    <form method="dialog" class="modal-box">
      <h3 class="text-2xl">Supprimer cette création ?</h3>
      <p class="py-4 text-base-content/70">« <span id="dlg-nom"></span> » sera définitivement supprimée.</p>
      <div class="modal-action">
        <button class="btn btn-ghost" value="non">Annuler</button>
        <button class="btn btn-error" value="oui">Supprimer</button>
      </div>
    </form>
  </dialog>
</Layout>

<script>
  const dlg = document.getElementById('dlg-supprimer') as HTMLDialogElement;
  let cible: string | null = null;
  document.querySelectorAll<HTMLButtonElement>('[data-supprimer]').forEach((b) =>
    b.addEventListener('click', () => {
      cible = b.dataset.supprimer!;
      document.getElementById('dlg-nom')!.textContent = b.dataset.nom!;
      dlg.showModal();
    })
  );
  dlg.addEventListener('close', async () => {
    if (dlg.returnValue !== 'oui' || !cible) return;
    const res = await fetch(`/api/montres/${cible}`, { method: 'DELETE' });
    if (res.ok) document.querySelector(`[data-montre="${cible}"]`)?.remove();
    else alert((await res.json()).erreur);
  });
</script>
