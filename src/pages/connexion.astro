---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';

const { user, t } = Astro.locals;
const next = Astro.url.searchParams.get('next') || '/montres';
const suivant = next.startsWith('/') && !next.startsWith('//') ? next : '/montres';
if (user) return Astro.redirect(suivant);

const erreur = Astro.url.searchParams.get('erreur');
const onglet = Astro.url.searchParams.get('onglet') === 'inscription' ? 'inscription' : 'connexion';
const raison = Astro.url.searchParams.get('raison');
const googleActif = !!process.env.GOOGLE_CLIENT_ID;
---
<Layout titre={t('auth.titre')} description="Connectez-vous ou créez votre compte TiK•TaK pour enregistrer vos montres personnalisées et suivre vos commandes." noindex>
  <div class="max-w-6xl mx-auto px-4 py-12 grid lg:grid-cols-2 gap-12 items-center">
    <div class="hidden lg:block space-y-6">
      <Logo class="text-4xl" />
      <h1 class="text-5xl leading-tight">Vos créations vous attendent.</h1>
      <ul class="space-y-3 text-base-content/70">
        <li>— Enregistrez autant de modèles que vous le souhaitez</li>
        <li>— Modifiez-les à tout moment, même après les avoir partagés</li>
        <li>— Suivez vos commandes et votre historique d’achats</li>
      </ul>
    </div>

    <div class="card bg-base-100 border border-base-300 w-full max-w-md mx-auto">
      <div class="card-body gap-5">
        <h2 class="text-3xl text-center">{t('auth.titre')}</h2>
        {raison === 'enregistrer' && (
          <div class="alert alert-info text-sm">Connectez-vous pour enregistrer votre création : elle sera conservée telle quelle.</div>
        )}
        {erreur && <div class="alert alert-error text-sm" role="alert">{erreur}</div>}

        <a href={`/api/auth/google?next=${encodeURIComponent(suivant)}`} class:list={['btn btn-outline border-base-300 gap-3', !googleActif && 'btn-disabled']} aria-disabled={!googleActif}>
          <svg class="size-5" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
          {t('auth.google')}
        </a>
        {!googleActif && <p class="text-xs text-center text-base-content/50 -mt-3">Connexion Google non configurée sur ce serveur (GOOGLE_CLIENT_ID).</p>}

        <div class="divider text-xs text-base-content/50 my-0">ou par e-mail</div>

        <div role="tablist" class="tabs tabs-border">
          <a role="tab" href={`?onglet=connexion&next=${encodeURIComponent(suivant)}`} class:list={['tab', onglet === 'connexion' && 'tab-active']}>{t('auth.connexion')}</a>
          <a role="tab" href={`?onglet=inscription&next=${encodeURIComponent(suivant)}`} class:list={['tab', onglet === 'inscription' && 'tab-active']}>{t('auth.inscription')}</a>
        </div>

        {onglet === 'connexion' ? (
          <form method="POST" action="/api/auth/login" class="space-y-3">
            <input type="hidden" name="next" value={suivant} />
            <label class="floating-label w-full">
              <span>E-mail</span>
              <input type="email" name="email" class="input w-full" placeholder="E-mail" autocomplete="email" required />
            </label>
            <label class="floating-label w-full">
              <span>Mot de passe</span>
              <input type="password" name="mot_de_passe" class="input w-full" placeholder="Mot de passe" autocomplete="current-password" required />
            </label>
            <button class="btn btn-primary w-full">{t('auth.connexion')}</button>
            <p class="text-xs text-base-content/50 text-center">Compte de démonstration : camille@demo.fr / tiktak2026</p>
          </form>
        ) : (
          <form method="POST" action="/api/auth/register" class="space-y-3">
            <input type="hidden" name="next" value={suivant} />
            <label class="floating-label w-full">
              <span>Prénom et nom</span>
              <input name="nom" class="input w-full" placeholder="Prénom et nom" autocomplete="name" required maxlength="80" />
            </label>
            <label class="floating-label w-full">
              <span>E-mail</span>
              <input type="email" name="email" class="input w-full" placeholder="E-mail" autocomplete="email" required />
            </label>
            <label class="floating-label w-full">
              <span>Mot de passe (8 caractères min.)</span>
              <input type="password" name="mot_de_passe" class="input w-full validator" placeholder="Mot de passe (8 caractères min.)" minlength="8" autocomplete="new-password" required />
            </label>
            <button class="btn btn-primary w-full">{t('auth.inscription')}</button>
            <p class="text-xs text-base-content/50 text-center">En créant un compte, vous acceptez nos conditions générales de vente.</p>
          </form>
        )}
      </div>
    </div>
  </div>
</Layout>
