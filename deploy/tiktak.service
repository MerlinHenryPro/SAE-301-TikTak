# Service systemd : redémarrage automatique de TiK•TaK (crash et reboot du VPS)
# Installation :
#   sudo cp deploy/tiktak.service /etc/systemd/system/tiktak.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tiktak
#   sudo systemctl status tiktak      # vérifier
#   journalctl -u tiktak -f           # logs
[Unit]
Description=TiK•TaK - configurateur de montres (Astro / Node)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/tiktak
EnvironmentFile=/var/www/tiktak/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /var/www/tiktak/dist/server/entry.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
